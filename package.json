{
  "name": "myspmj",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Pengurusan Masjid Johor - web + mobile PWA demo (Phase 1-3 skeleton, Bahasa Melayu first)",
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "db:gen": "prisma generate",
    "test": "tsx tests/src/lib/payments.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "jobs:notifications": "tsx scripts/run-queue.ts notifications",
    "jobs:scoring": "tsx scripts/run-queue.ts scoring",
    "jobs:tpmj": "tsx scripts/run-queue.ts tpmj",
    "jobs:jainj": "tsx scripts/run-queue.ts jainj",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.8.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@prisma/client": "^6.5.0",
    "bullmq": "^6.5.3",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.485.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
