# Production (Vercel + Neon PostgreSQL).
# Provision a Neon database, then set DATABASE_URL to its connection string.
# Local development now requires a PostgreSQL server (Docker is not available
# on the demo machine — install PostgreSQL locally or point at a Neon dev branch).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Auth.js — must match the production site URL (next-auth callbacks).
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="https://masjainj.vercel.app"
NEXTAUTH_URL="https://masjainj.vercel.app"

# Google login (optional). Redirect URI: https://masjainj.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password used by every seeded demo account
DEMO_PASSWORD="demo1234"

# Object storage (D02). Default "local" writes to .storage/ (dev only).
# Production: set to "s3" and point at an S3-compatible store (Neon Object Storage, MinIO).
STORAGE_PROVIDER="local"
# S3-compatible backend (only used when STORAGE_PROVIDER=s3):
STORAGE_ENDPOINT="https://<bucket>.<region>.objstorage.neon.tech"
STORAGE_BUCKET="spmj-documents"
STORAGE_ACCESS_KEY_ID="<access-key>"
STORAGE_SECRET_ACCESS_KEY="<secret-key>"
STORAGE_REGION="ap-southeast-1"
STORAGE_FORCE_PATH_STYLE="true"

# Redis (D04 background jobs, BullMQ). Neon does not offer Redis natively —
# provision externally (Upstash, Redis Cloud, self-hosted) and set REDIS_URL.
REDIS_URL="redis://default:password@host:6379"
